---
interface Props {
	title?: string;
	huidigeNav?: "home" | "over" | "contact" | "bijbel";
}

const { title = "BereaBijbel", huidigeNav = "" } = Astro.props;

// Alleen indexeerbaar als expliciet ingesteld via omgevingsvariabele.
// Standaard (niet ingesteld, demo, preview) = noindex.
const indexable = import.meta.env.PUBLIC_INDEXABLE === "true";
---

<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{!indexable && <meta name="robots" content="noindex,nofollow" />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{title}</title>
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Caveat:wght@500&display=swap");

			:root {
				--light: #ffffff;
				--lightgray: #e5e5e5;
				--gray: #b3b3b3;
				--darkgray: #333333;
				--dark: #111111;
				--secondary: #1a1a1a;
				--tertiary: #757575;
				--bg: var(--light);
				--bg-soft: #f5f5f5;
				--border: var(--lightgray);
				--tekst: var(--darkgray);
				--accent: var(--secondary);
				--accent-donker: var(--dark);
				--body-font: "Lora", Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, serif;
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme="light"]) {
					--light: #1b1a17;
					--lightgray: #34322b;
					--gray: #6b6558;
					--darkgray: #e4dfd1;
					--dark: #f5f2ea;
					--secondary: #e8e3d4;
					--tertiary: #a39c89;
					--bg-soft: #242219;
				}
			}
			:root[data-theme="dark"] {
				--light: #1b1a17;
				--lightgray: #34322b;
				--gray: #6b6558;
				--darkgray: #e4dfd1;
				--dark: #f5f2ea;
				--secondary: #e8e3d4;
				--tertiary: #a39c89;
				--bg-soft: #242219;
			}

			* { box-sizing: border-box; }
			html, body { margin: 0; padding: 0; }
			body {
				font-family: var(--body-font);
				background: var(--bg);
				color: var(--tekst);
				line-height: 1.7;
				-webkit-font-smoothing: antialiased;
			}
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
			::selection { background: var(--bg-soft); }
			a { color: var(--accent); }

			.site-header {
				text-align: center;
				padding: 2.2rem 1rem 0;
				margin-bottom: 3rem;
			}
			.page-title {
				margin: 0 0 0.3rem;
				font-size: 1.75rem;
				font-weight: 700;
			}
			.page-title a {
				color: var(--secondary);
				text-decoration: none;
			}
			.page-title a:hover { color: var(--accent-donker); }
			.site-subtitle {
				margin: 0 0 1rem;
				font-size: 1.05rem;
				color: var(--secondary);
			}
			.subtitel-spatie { display: inline; }
			.subtitel-nl { display: none; }
			@media (max-width: 480px) {
				.subtitel-spatie { display: none; }
				.subtitel-nl { display: block; }
			}
			.site-nav {
				text-align: center;
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				padding: 1rem 0;
				margin: 2rem 0 0;
			}
			.site-nav a {
				font-family: var(--body-font);
				font-size: 1.05rem;
				color: var(--tekst);
				text-decoration: none;
			}
			.site-nav a:hover { text-decoration: underline; }
			.site-nav a[aria-current="true"] { color: var(--tertiary); cursor: default; }
			.site-nav a[aria-current="true"]:hover { text-decoration: none; }
			.nav-sep { color: var(--gray); margin: 0 0.5rem; }

			main {
				max-width: 700px;
				margin: 0 auto;
				padding: 0 1.2rem 4.5rem;
			}

			.prose p { margin: 0 0 1.1rem; }
			.prose ul { margin: 0 0 1.1rem; padding-left: 1.3rem; }
			.prose li { margin-bottom: 0.4rem; }
			h2.sectie {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--dark);
				margin: 2.2rem 0 1rem;
			}
			h2.sectie:first-child { margin-top: 0; }

			footer.foot {
				text-align: center;
				margin-top: 3.5rem;
				padding-top: 1.2rem;
				border-top: 1px solid var(--border);
				font-family: sans-serif;
				font-size: 0.74rem;
				color: var(--tertiary);
			}
			footer.foot span { margin: 0 0.6rem; }

			.toast {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%);
				background: var(--dark);
				color: var(--light);
				padding: 0.5rem 1rem;
				border-radius: 6px;
				font-family: sans-serif;
				font-size: 0.85rem;
				opacity: 0.95;
				z-index: 50;
			}
			.toast[hidden] { display: none; }
		</style>
		<style is:global>
			/* ---------- zoekbalk, hoofdstuknavigatie: gedeeld door home en hoofdstukpagina's ---------- */
			.zoekbalk {
				position: relative;
				max-width: 640px;
				margin: 1.4rem auto 1.6rem;
			}
			#search {
				display: block;
				box-sizing: border-box;
				width: 100%;
				font-family: var(--body-font);
				font-size: 1.05rem;
				line-height: 1.5;
				text-align: center;
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.6rem 2.4rem 0.6rem 2.4rem;
				color: var(--tekst);
				background: var(--bg);
			}
			#search::placeholder { color: var(--gray); }
			#search:focus { outline: none; border-color: var(--accent); }
			.zoek-icoon {
				position: absolute;
				left: calc(50% - 73px);
				top: 50%;
				transform: translateY(-50%);
				color: var(--gray);
				pointer-events: none;
			}
			.search-error {
				max-width: 640px;
				margin: 0.4rem auto 0;
				color: #a33;
				font-size: 0.8rem;
				font-family: sans-serif;
				text-align: center;
			}
			.search-error[hidden] { display: none; }

			#hoofdstuktitel {
				text-align: center;
				font-size: 1.75rem;
				font-weight: 700;
				color: var(--tekst);
				margin: 2rem 0 0.4rem;
			}

			.hfdnav {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.6rem;
				flex-wrap: wrap;
				padding: 1rem 0;
				margin-bottom: 1.1rem;
			}
			.hfdnav select {
				font-family: var(--body-font);
				font-size: 1.05rem;
				line-height: 1.7;
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.3rem 1.6rem 0.3rem 0.8rem;
				background: var(--bg);
				color: var(--tekst);
				cursor: pointer;
			}
			.hfdnav select:focus { outline: none; border-color: var(--accent); }

			/* ---------- versregels en detailpaneel ---------- */
			#chapter-verses, #home-verses { font-size: 1.05rem; }
			.vers { position: relative; border-radius: 8px; line-height: 1.75; }
			.vers-hoofd {
				display: flex;
				gap: 0.8rem;
				padding: 0.5rem 0.8rem 0.5rem 0.4rem;
				border-radius: 8px;
				cursor: pointer;
			}
			.vers-hoofd:hover { background: var(--bg-soft); }
			.vers.open { box-shadow: 0 0 0 1px var(--border); }
			.vers.open .vers-hoofd { border-radius: 8px 8px 0 0; background: var(--bg-soft); }
			.vnr {
				color: var(--gray);
				font-size: 0.75rem;
				min-width: 1.7rem;
				text-align: right;
				padding-top: 0.35rem;
				flex-shrink: 0;
				font-family: sans-serif;
			}
			.vtekst { flex: 1; }
			.vers-detail {
				/* links op één lijn met de verstekst: 0,4 (padding) + 1,7 (nummer) + 0,8 (tussenruimte) */
				padding: 0.4rem 1.2rem 1.3rem 2.9rem;
				font-size: 0.92rem;
				background: var(--bg-soft);
				border-radius: 0 0 8px 8px;
			}
			@media (max-width: 560px) { .vers-detail { padding-left: 1.2rem; } }
			.placeholder-detail { font-style: italic; color: var(--tertiary); margin: 0 0 0.8rem; }

			.tabs { display: flex; gap: 1.2rem; border-bottom: 1px solid var(--border); margin-bottom: 0.9rem; }
			.tab {
				font-family: sans-serif;
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--tertiary);
				background: none;
				border: none;
				border-bottom: 2px solid transparent;
				padding: 0.2rem 0 0.5rem;
				margin-bottom: -1px;
				cursor: pointer;
			}
			.tab:hover { color: var(--accent-donker); }
			.tab[aria-selected="true"] { color: var(--accent-donker); border-bottom-color: var(--accent-donker); }
			.tab-paneel[hidden] { display: none; }
			.tab-paneel { margin-bottom: 0; }
			.tab-vers { margin: 0; font-size: 1rem; line-height: 1.7; }
			.vertaling + .vertaling { margin-top: 1.3rem; }
			.vt-label { font-family: sans-serif; font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tertiary); margin: 0 0 0.25rem; }
			.vt-leeg { font-style: italic; color: var(--tertiary); }
			.voetnoten { margin: 0; padding-left: 0; list-style: none; font-size: 0.88rem; line-height: 1.6; color: var(--tekst); }
			.voetnoten li { margin-bottom: 0.4rem; padding: 0.3rem 0.5rem; margin-left: -0.5rem; border-radius: 4px; }
			.voetnoten li.actief { background: var(--lightgray); }
			.vn-anker { font-weight: 600; color: var(--accent-donker); }
			.vn-anker::after { content: " —"; font-weight: 400; }

			/* Woordenraster: gelijke cellen; grondtekst, Nederlandse tegenhanger, Strong-nummer. */
			.segmenten {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(5.4rem, 1fr));
				gap: 0.5rem;
			}
			.segment {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: flex-start;
				gap: 0.2rem;
				text-align: center;
				padding: 0.55rem 0.3rem 0.5rem;
				border: 1px solid transparent;
				border-radius: 6px;
				background: none;
				font: inherit;
				color: inherit;
				cursor: pointer;
			}
			.segment:hover, .segment.licht { background: var(--lightgray); }
			.segment:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
			.seg-grondtekst { font-size: 1.15rem; line-height: 1.3; color: var(--dark); font-style: normal; }
			.seg-nl { font-size: 0.88rem; line-height: 1.3; color: var(--tekst); }
			.seg-nl.leeg { color: var(--tertiary); }
			.seg-strong { font-family: sans-serif; font-size: 0.72rem; color: var(--tekst); opacity: 0.85; }
			/* Wederzijds: muis op een grondtekstblok licht het Nederlandse woord op, en andersom.
			   Er licht altijd maar één paar tegelijk op. */
			.vw { border-radius: 3px; transition: background 0.12s; }
			.vw.licht, .vers.open .vw:hover { background: var(--lightgray); box-shadow: 0 0 0 2px var(--lightgray); }
			.toevoeging-note { margin: 0.8rem 0 0; font-size: 0.8rem; color: var(--tertiary); }

			.woord-uitleg {
				margin-top: 1rem;
				padding-top: 0.9rem;
				border-top: 1px solid var(--border);
				font-size: 0.88rem;
				text-align: left;
			}
			.woord-uitleg[hidden] { display: none; }
			.uitleg-intro { margin: 0 0 0.6rem; color: var(--tekst); }
			.uitleg-intro b { color: var(--accent-donker); }
			.field-label {
				font-family: sans-serif;
				font-size: 0.66rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--tertiary);
				margin: 1.2rem 0 0.4rem;
			}
			.vindplaatsen-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.2rem; }
			.vp-item { padding: 0.3rem 0.4rem; border-radius: 4px; }
			.vp-item-hoofd { display: flex; gap: 0.6rem; font-size: 0.88rem; }
			.vp-ref { color: var(--tekst); font-weight: 600; min-width: 9rem; text-decoration: none; }
			a.vp-ref:hover, a.vp-ref:focus-visible { text-decoration: underline; color: var(--dark); }
			.vp-vorm { font-style: italic; color: var(--dark); }
			.vp-item:hover { background: var(--lightgray); }
			.vp-voorbeeld { margin: 0.7rem 0 0; padding: 0.7rem 0.9rem; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; }
			.vp-voorbeeld[hidden] { display: none; }
			.vp-voorbeeld p { margin: 0; }
			.vp-vers { font-size: 1rem; line-height: 1.6; }
			.vp-bron { font-family: sans-serif; font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tertiary); margin-right: 0.3rem; }
			.vp-vers + .vp-vers { margin-top: 0.7rem; }
			.vp-grondtekst { margin-top: 1.3rem !important; font-size: 1.02rem; line-height: 1.7; color: var(--dark); }
			.alle-link { color: var(--tekst); text-decoration: none; }
			.alle-link:hover { color: var(--dark); text-decoration: underline; }
			.vindplaatsen-note { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--tertiary); }

			.meld-btn {
				flex-shrink: 0;
				align-self: flex-start;
				margin-top: 0.3rem;
				width: 1.6rem;
				height: 1.6rem;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				border-radius: 999px;
				background: none;
				color: var(--tertiary);
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.15s, background 0.15s, color 0.15s;
			}
			.vers-hoofd:hover .meld-btn { opacity: 1; }
			.meld-btn:hover { background: var(--lightgray); color: var(--accent-donker); }

			@keyframes flits {
				0% { background: var(--lightgray); }
				100% { background: var(--bg-soft); }
			}
			.vers.flits .vers-hoofd { animation: flits 1.6s ease-out 1; }

			.cta-wrap { text-align: center; margin-top: 1.4rem; }
			.pill-btn {
				display: inline-block;
				font-family: var(--body-font);
				font-size: 0.98rem;
				color: var(--tekst);
				background: none;
				border: 1px solid var(--border);
				padding: 0.5rem 1.2rem;
				border-radius: 999px;
				cursor: pointer;
				text-decoration: none;
			}
			.pill-btn:hover { background: var(--bg-soft); color: var(--dark); }

			@media (prefers-reduced-motion: reduce) {
				* { transition: none !important; }
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<h2 class="page-title"><a href="/">BereaBijbel</a></h2>
			<p class="site-subtitle">Een betrouwbare vertaling,<span class="subtitel-spatie"> </span><br class="subtitel-nl" />in begrijpelijk Nederlands<br /><i>Volledig licentievrij</i></p>
			<nav class="site-nav">
				<a href="/" aria-current={huidigeNav === "home" ? "true" : "false"}>Home</a><span class="nav-sep">|</span>
				<a href="/bijbel" aria-current={huidigeNav === "bijbel" ? "true" : "false"}>Bijbel</a><span class="nav-sep">|</span>
				<a href="/over" aria-current={huidigeNav === "over" ? "true" : "false"}>Over</a><span class="nav-sep">|</span>
				<a href="/contact" aria-current={huidigeNav === "contact" ? "true" : "false"}>Contact</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="foot">
			<span>CC0 — data</span><span>MIT — code</span>
		</footer>

		<div id="toast" class="toast" hidden></div>

		<script>
			let toastTimer: ReturnType<typeof setTimeout>;
			function toonToast(tekst: string) {
				const el = document.getElementById("toast");
				if (!el) return;
				el.textContent = tekst;
				el.hidden = false;
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => { el.hidden = true; }, 2400);
			}
			(window as any).toonToast = toonToast;
		</script>
	</body>
</html>
