---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { laadGrondtekstHoofdstuk, zoekVindplaatsen } from "../../lib/grondtekst";

interface BoekInfo {
	code: string;
	nummer: number;
	naam_en: string;
	testament: "ot" | "nt";
	hoofdstukken: number;
}

const DATA_ROOT = path.join(process.cwd(), "..", "data", "kjv");

export async function getStaticPaths() {
	const dataRoot = path.join(process.cwd(), "..", "data", "kjv");
	const index: BoekInfo[] = JSON.parse(
		fs.readFileSync(path.join(dataRoot, "index.json"), "utf-8"),
	);

	const paths = [];
	for (const boek of index) {
		for (let h = 1; h <= boek.hoofdstukken; h++) {
			paths.push({
				params: { boek: boek.code, hoofdstuk: String(h) },
				props: { boekInfo: boek, alleBoeken: index },
			});
		}
	}
	return paths;
}

const { boek, hoofdstuk } = Astro.params;
const { boekInfo, alleBoeken } = Astro.props as { boekInfo: BoekInfo; alleBoeken: BoekInfo[] };

const hoofdstukNummer = Number(hoofdstuk);
const bestandsnaam = String(hoofdstukNummer).padStart(2, "0") + ".json";
const hoofdstukData = JSON.parse(
	fs.readFileSync(path.join(DATA_ROOT, boek!, bestandsnaam), "utf-8"),
);
const verzen: { vers: number; tekst: string }[] = hoofdstukData.verzen;

const hoofdstukkenVanDitBoek = Array.from({ length: boekInfo.hoofdstukken }, (_, i) => i + 1);

// Grondtekst + Strong-nummers erbij, indien beschikbaar voor dit hoofdstuk.
const naamPerCode = new Map(alleBoeken.map((b) => [b.code, b.naam_en]));
const grondtekstHoofdstuk = laadGrondtekstHoofdstuk(boekInfo.testament, boek!, hoofdstukNummer);
const grondtekstPerVers = new Map(
	(grondtekstHoofdstuk?.verzen ?? []).map((v) => [v.vers, v]),
);

const versDetail: Record<
	number,
	{
		woorden: {
			tekst: string;
			strong: string;
			morf: string | null;
			vindplaatsen: { totaal: number; voorbeelden: { boek: string; naam: string; hoofdstuk: number; vers: number; tekst: string }[] };
		}[];
	}
> = {};

for (const v of verzen) {
	const gt = grondtekstPerVers.get(v.vers);
	if (!gt) continue;
	versDetail[v.vers] = {
		woorden: gt.woorden.map((w) => {
			const { totaal, voorbeelden } = zoekVindplaatsen(w.strong, {
				boek: boek!,
				hoofdstuk: hoofdstukNummer,
				vers: v.vers,
			});
			return {
				tekst: w.tekst,
				strong: w.strong,
				morf: w.morf,
				vindplaatsen: {
					totaal,
					voorbeelden: voorbeelden.map((vp) => ({
						...vp,
						naam: naamPerCode.get(vp.boek) ?? vp.boek,
					})),
				},
			};
		}),
	};
}
---

<Base title={`${boekInfo.naam_en} ${hoofdstukNummer} — BereaBijbel`} huidigeNav="bijbel">
	<p class="testdata-melding">
		Testdata — King James Version (Pure Cambridge Edition), Engels. Nederlandse
		vertaling volgt. Grondtekst en Strong-nummers ({boekInfo.testament === "ot" ? "WLC" : "Elzevir TR"}) zijn
		al beschikbaar, los van de vertaling.
	</p>

	<div class="zoekbalk">
		<input id="search" type="text" placeholder="Zoek op vers, bijv. John 3:16" autocomplete="off" />
	</div>
	<div id="search-error" class="search-error" hidden></div>

	<h1 id="hoofdstuktitel">{boekInfo.naam_en} {hoofdstukNummer}</h1>

	<nav class="hfdnav">
		<select id="book-select">
			{alleBoeken.map((b) => (
				<option value={b.code} selected={b.code === boek}>{b.naam_en}</option>
			))}
		</select>
		<select id="chapter-select">
			{hoofdstukkenVanDitBoek.map((h) => (
				<option value={h} selected={h === hoofdstukNummer}>{h}</option>
			))}
		</select>
	</nav>

	<div id="chapter-verses">
		{verzen.map((v) => (
			<div class="vers" id={`vers-${v.vers}`} data-vers={v.vers}>
				<div class="vers-hoofd">
					<div class="vnr">{v.vers}</div>
					<div class="vtekst placeholder-tekst">{v.tekst}</div>
					<button class="meld-btn" type="button" title="Verbetering voorstellen bij dit vers" data-meld>
						<svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M5 17V4M5 4h9l-2 3 2 3H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
				</div>
			</div>
		))}
	</div>

	<script type="application/json" id="boekenindex" set:html={JSON.stringify(alleBoeken)} />
	<script type="application/json" id="versdetail" set:html={JSON.stringify(versDetail)} />

	<script>
		function normalizeBoek(s: string) {
			return s.trim().toLowerCase().replace(/\./g, "");
		}

		function initZoek() {
			const el = document.getElementById("boekenindex");
			if (!el) return;
			const boeken: { code: string; naam_en: string; hoofdstukken: number }[] = JSON.parse(el.textContent || "[]");

			const zoekEl = document.getElementById("search") as HTMLInputElement | null;
			const errorEl = document.getElementById("search-error");
			if (!zoekEl || !errorEl) return;

			zoekEl.addEventListener("keydown", (e) => {
				if (e.key !== "Enter") return;
				e.preventDefault();
				errorEl.hidden = true;
				const query = zoekEl.value.trim();
				if (!query) return;

				const m = query.match(/^(.*?)\s+(\d+)(?::(\d+))?\s*$/);
				if (!m) {
					errorEl.textContent = 'Gebruik het formaat "Boek hoofdstuk:vers", bijv. "John 3:16".';
					errorEl.hidden = false;
					return;
				}
				const rawBoek = normalizeBoek(m[1]);
				const gevonden = boeken.find((b) => normalizeBoek(b.naam_en).indexOf(rawBoek) === 0);
				if (!gevonden) {
					errorEl.textContent = `Boek "${m[1]}" niet gevonden.`;
					errorEl.hidden = false;
					return;
				}
				const hst = parseInt(m[2], 10);
				if (hst < 1 || hst > gevonden.hoofdstukken) {
					errorEl.textContent = `${gevonden.naam_en} heeft ${gevonden.hoofdstukken} hoofdstukken.`;
					errorEl.hidden = false;
					return;
				}
				const vers = m[3] ? `#vers-${m[3]}` : "";
				window.location.href = `/${gevonden.code}/${hst}${vers}`;
			});
		}

		function initSelects() {
			const boekSelect = document.getElementById("book-select") as HTMLSelectElement | null;
			const hstSelect = document.getElementById("chapter-select") as HTMLSelectElement | null;
			if (boekSelect) {
				boekSelect.addEventListener("change", () => {
					window.location.href = `/${boekSelect.value}/1`;
				});
			}
			if (hstSelect) {
				hstSelect.addEventListener("change", () => {
					const boek = window.location.pathname.split("/")[1];
					window.location.href = `/${boek}/${hstSelect.value}`;
				});
			}
		}

		interface WoordDetail {
			tekst: string;
			strong: string;
			morf: string | null;
			vindplaatsen: {
				totaal: number;
				voorbeelden: { boek: string; naam: string; hoofdstuk: number; vers: number; tekst: string }[];
			};
		}

		function buildVindplaatsenHtml(w: WoordDetail): string {
			const { totaal, voorbeelden } = w.vindplaatsen;
			if (totaal === 0) {
				return '<p class="vindplaatsen-note">Geen andere vindplaatsen van dit grondtaalwoord.</p>';
			}
			let html = '<ul class="vindplaatsen-list">';
			for (const vp of voorbeelden) {
				html += `<li class="vp-item"><div class="vp-item-hoofd"><span class="vp-ref">${vp.naam} ${vp.hoofdstuk}:${vp.vers}</span><span class="vp-vorm">${vp.tekst}</span></div></li>`;
			}
			html += "</ul>";
			if (totaal > voorbeelden.length) {
				html += `<p class="vindplaatsen-note">En ${totaal - voorbeelden.length} andere vindplaats${totaal - voorbeelden.length === 1 ? "" : "en"} (totaal ${totaal}).</p>`;
			}
			return html;
		}

		function buildWoordUitleg(w: WoordDetail): string {
			let html = `<p class="uitleg-intro"><b>${w.strong}</b>${w.morf ? " — " + w.morf : ""}</p>`;
			html += '<p class="field-label">Ook elders in de Bijbel</p>';
			html += buildVindplaatsenHtml(w);
			return html;
		}

		function buildDetail(woorden: WoordDetail[]): string {
			let html = '<div class="segmenten">';
			woorden.forEach((w, i) => {
				html += `<div class="segment" tabindex="0" role="button" aria-label="${w.strong}">`;
				html += `<div class="seg-grondtekst">${w.tekst}</div>`;
				html += `<button type="button" class="seg-strong-btn" data-i="${i}">${w.strong}</button>`;
				html += "</div>";
			});
			html += "</div>";
			html += '<div class="woord-uitleg" hidden></div>';
			return html;
		}

		function initVersen() {
			const el = document.getElementById("versdetail");
			const versDetail: Record<string, { woorden: WoordDetail[] }> = el
				? JSON.parse(el.textContent || "{}")
				: {};

			document.querySelectorAll<HTMLElement>(".vers").forEach((row) => {
				const hoofd = row.querySelector(".vers-hoofd");
				hoofd?.addEventListener("click", (e) => {
					if ((e.target as HTMLElement).closest("[data-meld]")) return;
					const open = row.classList.contains("open");
					document.querySelectorAll(".vers.open").forEach((r) => {
						r.classList.remove("open");
						r.querySelector(".vers-detail")?.remove();
					});
					if (open) return;
					row.classList.add("open");

					const versNummer = row.dataset.vers!;
					const detail = versDetail[versNummer];

					const panel = document.createElement("div");
					panel.className = "vers-detail";
					if (!detail) {
						panel.innerHTML =
							'<p class="placeholder-detail">Nog geen grondtekst gekoppeld aan dit vers.</p>';
						row.appendChild(panel);
						return;
					}

					panel.innerHTML =
						'<p class="placeholder-detail">Nog geen BereaBijbel-vertaling — hieronder wel al de grondtekst met Strong-nummers.</p>' +
						buildDetail(detail.woorden);
					row.appendChild(panel);

					const uitlegEl = panel.querySelector(".woord-uitleg") as HTMLElement;
					panel.querySelectorAll<HTMLElement>(".seg-strong-btn").forEach((btn) => {
						btn.addEventListener("click", (e) => {
							e.stopPropagation();
							const i = parseInt(btn.getAttribute("data-i") || "0", 10);
							if (!uitlegEl.hidden && uitlegEl.dataset.open === String(i)) {
								uitlegEl.hidden = true;
								uitlegEl.dataset.open = "";
								return;
							}
							uitlegEl.innerHTML = buildWoordUitleg(detail.woorden[i]);
							uitlegEl.hidden = false;
							uitlegEl.dataset.open = String(i);
						});
					});
				});
			});

			document.querySelectorAll<HTMLElement>("[data-meld]").forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.stopPropagation();
					(window as any).toonToast?.(
						"Bedankt voor je melding — wordt in deze testversie nog niet verwerkt.",
					);
				});
			});
		}

		function markeerVanuitHash() {
			const hash = window.location.hash;
			if (!hash) return;
			const target = document.querySelector(hash);
			if (!target) return;
			target.scrollIntoView({ behavior: "smooth", block: "center" });
			target.classList.add("flits");
			setTimeout(() => target.classList.remove("flits"), 1600);
		}

		initZoek();
		initSelects();
		initVersen();
		markeerVanuitHash();
	</script>
</Base>

<style>
	.testdata-melding {
		background: var(--gewogen-soft);
		border: 1px solid var(--gewogen);
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
		border-radius: 8px;
	}
	.zoekbalk {
		position: relative;
		max-width: 640px;
		margin: 1.4rem auto 0.4rem;
	}
	#search {
		display: block;
		width: 100%;
		font-family: var(--body-font);
		font-size: 0.95rem;
		line-height: 1.5;
		text-align: center;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.6rem 0.8rem;
		color: var(--tekst);
		background: var(--bg);
	}
	#search::placeholder { color: var(--gray); }
	#search:focus { outline: none; border-color: var(--accent); }
	.search-error {
		max-width: 640px;
		margin: 0.4rem auto 0;
		color: #a33;
		font-size: 0.8rem;
		font-family: sans-serif;
		text-align: center;
	}
	.search-error[hidden] { display: none; }

	#hoofdstuktitel {
		text-align: center;
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--tekst);
		margin: 2rem 0 0.4rem;
	}

	.hfdnav {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
		font-size: 0.85rem;
		padding: 1rem 0;
		margin-bottom: 1.1rem;
	}
	.hfdnav select {
		font-family: var(--body-font);
		font-size: 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.3rem 1.6rem 0.3rem 0.8rem;
		background: var(--bg);
		color: var(--accent-donker);
		cursor: pointer;
	}
	.hfdnav select:focus { outline: none; border-color: var(--accent); }

	#chapter-verses { font-size: 1.05rem; }
	.vers { position: relative; border-radius: 8px; line-height: 1.75; }
	.vers-hoofd {
		display: flex;
		gap: 0.8rem;
		padding: 0.5rem 0.8rem 0.5rem 0.4rem;
		border-radius: 8px;
		cursor: pointer;
	}
	.vers-hoofd:hover { background: var(--bg-soft); }
	.vers.open .vers-hoofd { border-radius: 8px 8px 0 0; background: var(--bg-soft); }
	.vnr {
		color: var(--gray);
		font-size: 0.75rem;
		min-width: 1.7rem;
		text-align: right;
		padding-top: 0.35rem;
		flex-shrink: 0;
		font-family: sans-serif;
	}
	.vtekst { flex: 1; }
	.vers-detail {
		padding: 1rem 1.2rem 1.2rem;
		font-size: 0.92rem;
		background: var(--bg-soft);
		border-radius: 0 0 8px 8px;
	}
	.placeholder-detail { font-style: italic; color: var(--tertiary); margin: 0 0 0.8rem; }

	.segmenten {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
	}
	.segment {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		min-width: 3.2rem;
		max-width: 11rem;
		padding: 0.2rem 0.3rem;
		border-radius: 4px;
		cursor: pointer;
	}
	.segment:hover, .segment:focus { background: var(--lightgray); outline: none; }
	.seg-grondtekst {
		font-style: italic;
		color: var(--dark);
		font-size: 1.05rem;
		margin: 0.1rem 0;
	}
	.seg-strong-btn {
		font-family: sans-serif;
		font-size: 0.6rem;
		color: var(--tertiary);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}
	.seg-strong-btn:hover, .seg-strong-btn:focus { color: var(--accent); text-decoration: underline; }

	.woord-uitleg {
		margin-top: 1rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--border);
		font-size: 0.88rem;
		text-align: left;
	}
	.woord-uitleg[hidden] { display: none; }
	.uitleg-intro { margin: 0 0 0.6rem; color: var(--tekst); }
	.uitleg-intro b { color: var(--accent-donker); }
	.field-label {
		font-family: sans-serif;
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--tertiary);
		margin: 0.7rem 0 0.3rem;
	}
	.vindplaatsen-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.2rem; }
	.vp-item { padding: 0.3rem 0.4rem; border-radius: 4px; }
	.vp-item-hoofd { display: flex; gap: 0.6rem; font-size: 0.88rem; }
	.vp-ref { color: var(--tekst); font-weight: 600; min-width: 9rem; }
	.vp-vorm { font-style: italic; color: var(--dark); }
	.vindplaatsen-note { margin: 0.35rem 0 0; font-size: 0.8rem; color: var(--tertiary); }

	.meld-btn {
		flex-shrink: 0;
		align-self: flex-start;
		margin-top: 0.3rem;
		width: 1.6rem;
		height: 1.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 999px;
		background: none;
		color: var(--tertiary);
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.15s, background 0.15s, color 0.15s;
	}
	.vers-hoofd:hover .meld-btn { opacity: 1; }
	.meld-btn:hover { background: var(--lightgray); color: var(--accent-donker); }

	@keyframes flits {
		0% { background: var(--lightgray); }
		100% { background: var(--bg-soft); }
	}
	.vers.flits .vers-hoofd { animation: flits 1.6s ease-out 1; }
</style>
